# No-cache for all API PHP endpoints
# Prevents Hostinger LiteSpeed from caching dynamic search/filter results

<IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</IfModule>

# LiteSpeed: bypass cache for all requests in /api/
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>
